<?xml version="1.0"?>
<Container version="2">
  <Name>Corgio</Name>
  <Repository>ghcr.io/exh555/corgio:latest</Repository>
  <Registry>https://ghcr.io</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/exh555/Corgio/issues</Support>
  <Project>https://github.com/exh555/Corgio</Project>
  <Overview>A self-hosted, privacy-first web application for downloading and managing video and audio media using yt-dlp and ffmpeg. Features a Traditional Flat Command Deck UI, live self-updating engines, built-in forms authentication, and zero-trace privacy architecture.</Overview>
  <Category>Downloaders: MediaApp:Video MediaApp:Audio</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/exh555/Corgio/main/unraid-templates/corgio.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/exh555/Corgio/main/icon.svg</Icon>
  <ExtraParams>--security-opt no-new-privileges:true</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled></DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Description>A self-hosted, privacy-first web application for downloading and managing video and audio media using yt-dlp and ffmpeg.</Description>
  <Networking>
    <Mode>bridge</Mode>
    <Publish>
      <Port>
        <HostPort>8080</HostPort>
        <ContainerPort>8080</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Data>
    <Volume>
      <HostDir>/mnt/user/appdata/corgio</HostDir>
      <ContainerDir>/config</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
    <Volume>
      <HostDir>/mnt/user/downloads/</HostDir>
      <ContainerDir>/downloads</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
  </Data>
  <Environment>
    <Variable>
      <Value>99</Value>
      <Name>PUID</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>100</Value>
      <Name>PGID</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>002</Value>
      <Name>UMASK</Name>
      <Mode/>
    </Variable>
  </Environment>
  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Description="Web interface port" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Config Directory" Target="/config" Default="/mnt/user/appdata/corgio" Mode="rw" Description="Persistent database, in-app engine updates, and settings storage" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/corgio</Config>
  <Config Name="Downloads Directory" Target="/downloads" Default="/mnt/user/downloads/" Mode="rw" Description="Location where completed video/audio files are saved" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/downloads/</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID for array file permissions (99 is Unraid nobody)" Type="Variable" Display="always" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID for array file permissions (100 is Unraid users)" Type="Variable" Display="always" Required="true" Mask="false">100</Config>
  <Config Name="UMASK" Target="UMASK" Default="002" Mode="" Description="File creation permissions mask for SMB share read/write access" Type="Variable" Display="always" Required="true" Mask="false">002</Config>
</Container>
